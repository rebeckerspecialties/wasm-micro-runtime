(module
  (type $f (func (result i32)))
  (import "actual" "host" (func $host (result i32)))
  (import "actual" "guest" (func $guest (result i32)))
  (import "shim" "table" (table 5 32 funcref))
  (export "table" (table 0))
  (global $counter (mut i32) (i32.const 21))
  (global $ref funcref (ref.func $own))
  (func $own (result i32)
    global.get $counter i32.const 1 i32.add global.set $counter
    global.get $counter)
  (func $wrong (result i64) i64.const 99)
  (elem (i32.const 1) $own $host $guest)
  (elem $passive func $own $wrong)
  (func (export "set") (param i32)
    local.get 0 global.get $ref table.set)
  (func (export "init") (param i32)
    local.get 0 i32.const 0 i32.const 2 table.init $passive)
  (func (export "fill") (param i32 i32)
    local.get 0 ref.func $own local.get 1 table.fill)
  (func (export "call") (param i32) (result i32)
    local.get 0 call_indirect (type $f)))
